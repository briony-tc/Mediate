# --- Local dev (npm run dev) ---
# SQLite database file path
DB_PATH=./data/media-library.db

# Root folders to watch. Must follow the movies/<title>/*.mkv and
# tv/<title>/<season>/*.mkv layout.
STAGING_PATH=/media/staging
JELLYFIN_PATH=/media/jellyfin

# --- Docker (docker-compose.yml) ---
# Host paths bind-mounted into the container at /media/staging and
# /media/jellyfin - the same folders MakeMKV rips into and Jellyfin serves
# from on the host. DB_PATH/STAGING_PATH/JELLYFIN_PATH above are unused in
# Docker; docker-compose.yml sets the in-container equivalents itself.
STAGING_HOST_PATH=/path/to/staging
JELLYFIN_HOST_PATH=/path/to/jellyfin

# --- Shared ---
# https://api.watchmode.com/ - required, no key-less trial available
WATCHMODE_API_KEY='REDACTED-ROTATED-KEY'

# https://www.upcitemdb.com/ - optional, falls back to the rate-limited trial endpoint
UPCITEMDB_API_KEY=
